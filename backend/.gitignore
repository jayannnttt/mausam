data/cache/
data/*.sqlite3
data/*.sqlite3-*

# Logs
ml_train.log

# NOTE: artifacts/ (model_bundle.joblib + metrics.json) is intentionally
# NOT ignored — the API serves these, and committing them lets a deploy
# run without retraining.
