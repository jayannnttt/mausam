# Mausam Sense ML backend — environment variables
#
# Copy to backend/.env (loaded automatically when python-dotenv is installed)
# or export these in your process/deployment environment.
#
# The service works with ZERO configuration: Open-Meteo sources are keyless.
# Only the optional official IMD integration needs a key.

# Origins allowed to call the API (comma separated).
# Local dev:  http://localhost:5173
# Production: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional: official IMD API key (distributed by IMD on request).
# Without it, every IMD comparison returns available=false with a reason.
IMD_API_KEY=
IMD_DISTRICT_ID=
IMD_BASE_URL=https://api.imd.gov.in/api/v1

# Optional storage overrides (defaults shown)
#MAUSAM_DATA_DIR=./data
#MAUSAM_ARTIFACTS_DIR=./artifacts
#MAUSAM_HISTORY_DB=./data/history.sqlite3
#MAUSAM_HISTORY_MAX_ROWS=500
